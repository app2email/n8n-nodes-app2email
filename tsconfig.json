{
	"compilerOptions": {
		"target": "ES2021",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2021"],
		"declaration": false,
		"sourceMap": false,
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"resolveJsonModule": true
	},
	"include": ["credentials/**/*.ts", "nodes/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
